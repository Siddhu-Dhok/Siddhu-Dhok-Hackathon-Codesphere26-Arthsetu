<?xml version="1.0" encoding="utf-8"?>
<!--
  Login screen — full-screen gradient (branding zone) + rising white card (action zone).
  windowSoftInputMode = adjustResize is forced in LoginFragment.onResume() so the
  ScrollView shrinks the branding zone and keeps the card above the keyboard.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_gradient"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minHeight="600dp">

        <!-- ══════════════════════════════════════════════════════════════
             BRANDING ZONE — collapses gracefully when keyboard opens
             ══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="28dp"
            android:paddingHorizontal="24dp">

            <!-- Logo: glow ring + inner ₹ -->
            <FrameLayout
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo_glow"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="₹"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

            </FrameLayout>

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ArthSetu AI"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.02"
                android:layout_marginBottom="8dp"/>

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your AI-powered financial companion"
                android:textSize="14sp"
                android:textColor="#AAFFFFFF"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <!-- Feature pills row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI Insights"
                    android:textSize="11.5sp"
                    android:textColor="#DDFFFFFF"
                    android:background="@drawable/bg_feature_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Wealth Track"
                    android:textSize="11.5sp"
                    android:textColor="#DDFFFFFF"
                    android:background="@drawable/bg_feature_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Goals"
                    android:textSize="11.5sp"
                    android:textColor="#DDFFFFFF"
                    android:background="@drawable/bg_feature_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════
             ACTION CARD — always visible above keyboard (adjustResize)
             ══════════════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="32dp"
            app:cardBackgroundColor="@color/surface"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="10dp"
                android:paddingBottom="36dp">

                <!-- Drag-handle pill (bottom-sheet feel) -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_divider_pill"/>

                <!-- Card heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back! 👋"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your mobile number to receive a verification code"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="28dp"/>

                <!-- Phone input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <!-- Country prefix box -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_phone_prefix"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🇮🇳"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  +91"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"/>

                    </LinearLayout>

                    <!-- 10-digit phone number input -->
                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:hint="00000 00000"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_phone_input"
                        android:singleLine="true"
                        android:imeOptions="actionDone"/>

                </LinearLayout>

                <!-- Helper text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒  A one-time verification code will be sent via SMS after the code check"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="16dp"/>

                <!-- Numerical captcha -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter the numbers below"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvCaptchaCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_phone_input"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary"
                        android:gravity="center"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshCaptcha"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/login_captcha_refresh"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:textColor="@color/primary"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/etCaptcha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/login_captcha_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:layout_marginBottom="20dp"/>

                <!-- Continue button -->
                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Continue →"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_continue"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="16dp"/>

                <!-- Loading state -->
                <LinearLayout
                    android:id="@+id/layoutLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/primary"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sending verification code…"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"/>

                </LinearLayout>

                <!-- Terms note -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="By continuing, you agree to our Terms of Service and Privacy Policy"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginTop="20dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
